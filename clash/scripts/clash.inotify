#!/system/bin/sh

scripts=`realpath $0`
scripts_dir=`dirname ${scripts}`
service_path="${scripts_dir}/clash.service"
tproxy_path="${scripts_dir}/clash.iptables"
wifi_path="${scripts_dir}/clash.wifi"
signal_file="${scripts_dir}/../run/cmdRunning"

events=$1
monitor_dir=$2
monitor_file=$3

service_control() {
    if [ "${monitor_file}" = "disable" ] ; then
        touch ${signal_file}
        if [ "${events}" = "d" ] ; then
            # Re-check Wi-Fi before starting; do not start Mihomo on Wi-Fi.
            nohup ${wifi_path} "${monitor_dir}" > /dev/null 2>&1 &
        elif [ "${events}" = "n" ] ; then
            ${service_path} -k && ${tproxy_path} -k
        fi
        rm ${signal_file}
    fi
}

service_control
